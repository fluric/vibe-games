dist/
build/
*.tsbuildinfo

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# TypeORM migrations (generated output)
backend/src/migrations/*.js

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

