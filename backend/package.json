{
  "name": "@vibe-games/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/game/aiConfig.json', 'dist/game/aiConfig.json')\"",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate src/migrations/$npm_config_name -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "tournament": "ts-node -r tsconfig-paths/register src/scripts/aiTournament.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@vibe-games/shared": "*",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
